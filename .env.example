# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API keys.
#
# The publishable key (sb_publishable_…) is safe in the browser — row-level
# security is what protects the data, not the key. On older projects this was
# called the anon key, and NEXT_PUBLIC_SUPABASE_ANON_KEY still works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The secret key (sb_secret_…) bypasses row-level security entirely, so it
# never goes near the browser. Needed for account deletion, the admin page and
# the demo seed. Formerly the service_role key; SUPABASE_SERVICE_ROLE_KEY still
# works.
SUPABASE_SECRET_KEY=

# ── Ask Marlow ──────────────────────────────────────────────────────────────
# Without this the app still works; Ask says plainly that it can't answer.
ANTHROPIC_API_KEY=

# ── Deployment ──────────────────────────────────────────────────────────────
# Where magic links come back to. Must be in Supabase's redirect allow-list.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails allowed into /admin. Everyone else gets a 404.
MARLOW_FOUNDER_EMAILS=

# ── Optional: the daily email nudge ─────────────────────────────────────────
# The cron route no-ops safely if these are unset.
CRON_SECRET=
RESEND_API_KEY=
MARLOW_FROM_EMAIL=

# ── Local only ──────────────────────────────────────────────────────────────
# Switches on /preview, the design harness. Never set this in production.
MARLOW_PREVIEW=
